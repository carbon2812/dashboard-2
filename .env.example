# Database configuration (Optional: leave empty to use in-memory / local persistent demo store)
MONGODB_URI=mongodb://localhost:27017/fintech_expenses

# Google Drive Integration (Optional: leave empty to use local simulated Drive mode)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_DRIVE_FOLDER_ID=

# Alternatively, Google Service Account JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standalone Express Server Port
PORT=5000
