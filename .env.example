# ========================================================
# EXPENSE TRACKER - VPS CUSTOM PORT ALLOCATIONS
# Avoids any conflict with existing projects on the VPS
# ========================================================

# Nginx Gateway Port (Default: 8088, or set to 0 for a dynamic random port)
NGINX_PORT=8088

# Next.js Frontend Host Port (Changed from 3000 -> 3005)
FRONTEND_PORT=3005

# Express API Backend Host Port (Changed from 5001 -> 5055)
BACKEND_PORT=5055

# PostgreSQL Database Host Port (Changed from 5432/5434 -> 5438)
POSTGRES_PORT=5438

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# Backend Security & CORS
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
CORS_ORIGIN=http://localhost:3005,http://localhost:3000,http://localhost:8088

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3005
