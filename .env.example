# ===============================================
# EXPENSE TRACKER - DOCKER COMPOSE CONFIGURATION
# ===============================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# Backend Security
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nginx Reverse Proxy (0 = Docker picks a random available host port, or set a specific port e.g. 8080)
NGINX_PORT=0
