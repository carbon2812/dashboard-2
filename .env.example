# ========================================================
# EXPENSE TRACKER - VPS CUSTOM PORT ALLOCATIONS
# Avoids any conflict with existing projects on the VPS
# ========================================================

# Nginx Gateway Port (Randomized high port)
NGINX_PORT=28491

# Next.js Frontend Host Port (Randomized high port)
FRONTEND_PORT=23085

# Express API Backend Host Port (Randomized high port)
BACKEND_PORT=25062

# PostgreSQL Database Host Port (Randomized high port)
POSTGRES_PORT=25489

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# Backend Security & CORS
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
CORS_ORIGIN=https://www.samarth.tech,https://samarth.tech,https://api.samarth.tech,http://www.samarth.tech,http://samarth.tech,http://api.samarth.tech,http://localhost:3005,http://localhost:3000,http://localhost:8088

# Frontend URL
NEXT_PUBLIC_APP_URL=https://www.samarth.tech
