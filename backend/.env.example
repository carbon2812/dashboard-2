# ===============================================
# EXPENSE TRACKER - BACKEND CONFIGURATION
# ===============================================

# Server Environment
NODE_ENV=production
PORT=5001

# PostgreSQL Database Connection URL
# For Docker network: postgresql://postgres:postgres@postgres:5432/expense_tracker?schema=public
# For Local host:     postgresql://postgres:postgres@localhost:5434/expense_tracker?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/expense_tracker?schema=public"

# Cryptographic JWT Secret Key (Set a secure random 32+ character string in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_in_production"

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Local VPS Storage Path
UPLOAD_DIR="./uploads"
