# ===============================================
# EXPENSE TRACKER - BACKEND CONFIGURATION
# ===============================================

PORT=25062

# Prisma PostgreSQL Connection URL (Host port 25489 for local tools, inside docker: postgres:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:25489/expense_tracker?schema=public"

# JWT Secret Key
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production

# Allowed CORS Origins
CORS_ORIGIN=https://www.samarth.tech,https://samarth.tech,https://api.samarth.tech,http://www.samarth.tech,http://samarth.tech,http://api.samarth.tech,http://localhost:23085,http://localhost:28491,http://localhost:3000,http://localhost:8088

# Local VPS Uploads Directory
UPLOAD_DIR=./uploads
