generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#6366f1")
  icon        String    @default("Layers")
  description String?
  budget      Float?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@map("categories")
}

model Expense {
  id            String      @id @default(cuid())
  amount        Float
  currency      String      @default("INR")
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date          String      // Formatted "YYYY-MM-DD"
  description   String
  merchant      String?
  paymentMethod String      @default("Corporate Card")
  status        String      @default("Approved")
  attachment    Attachment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

model Attachment {
  id           String   @id @default(cuid())
  expenseId    String?  @unique
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name         String
  mimeType     String
  size         Int
  url          String?
  filename     String?
  localUrl     String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@map("attachments")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  initials  String   @default("U")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
