generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  userId      String?
  name        String
  color       String    @default("#6366f1")
  icon        String    @default("Layers")
  description String?
  budget      Float?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@index([userId])
  @@map("categories")
}

model Expense {
  id            String      @id @default(cuid())
  userId        String?
  amount        Float
  currency      String      @default("INR")
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date          String      // Formatted "YYYY-MM-DD"
  description   String
  merchant      String?
  paymentMethod String      @default("Corporate Card")
  status        String      @default("Approved")
  attachment    Attachment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

model Attachment {
  id           String   @id @default(cuid())
  expenseId    String?  @unique
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name         String
  mimeType     String
  size         Int
  url          String?
  filename     String?
  localUrl     String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@map("attachments")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  initials  String   @default("U")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Employee {
  id             String          @id @default(cuid())
  userId         String?
  name           String
  email          String?
  phone          String?
  department     String          @default("Engineering")
  designation    String          @default("Software Engineer")
  baseSalary     Float           @default(0)
  status         String          @default("Active") // Active, On Leave, Terminated
  joinDate       String          // Formatted "YYYY-MM-DD"
  avatar         String?
  salaryPayments SalaryPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@map("employees")
}

model SalaryPayment {
  id            String    @id @default(cuid())
  userId        String?
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         String    // e.g. "2026-10" or "October 2026"
  baseSalary    Float
  bonus         Float     @default(0)
  deductions    Float     @default(0)
  netSalary     Float
  paymentDate   String    // Formatted "YYYY-MM-DD"
  paymentMethod String    @default("Bank Transfer") // Bank Transfer, UPI, Cheque, Cash
  status        String    @default("Paid") // Paid, Pending
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([employeeId])
  @@index([paymentDate])
  @@map("salary_payments")
}

model Project {
  id          String        @id @default(cuid())
  userId      String?
  title       String
  description String?
  client      String?
  category    String?       @default("General")
  status      String        @default("In Progress") // Planning, In Progress, In Review, Completed, On Hold
  priority    String        @default("Medium") // Low, Medium, High, Urgent
  budget      Float         @default(0)
  spent       Float         @default(0)
  currency    String        @default("INR")
  startDate   String
  deadline    String
  progress    Int           @default(0)
  teamMembers String[]      @default([])
  tasks       ProjectTask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("projects")
}

model ProjectTask {
  id                   String    @id @default(cuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  assignedEmployeeId   String?
  assignedEmployeeName String?
  status               String    @default("Todo") // Todo, In Progress, Done
  priority             String    @default("Medium") // Low, Medium, High, Urgent
  dueDate              String?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("project_tasks")
}

